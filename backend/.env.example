PORT=5000
NODE_ENV=development
DB_DRIVER=postgres
# Set DATABASE_URL or PGPASSWORD to a strong, unique password (never 'postgres').
DATABASE_URL=postgresql://postgres:change-me-to-a-strong-password@localhost:5432/glorious_hr
DB_FILE=data/glorious_hr.db
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=glorious_hr
MSSQL_USER=sa
MSSQL_PASSWORD=your-mssql-password
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERT=false
JWT_SECRET=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-a-different-at-least-32-random-string
JWT_EXPIRES_IN=15m
JWT_ISSUER=glorious-hr-api
JWT_AUDIENCE=glorious-hr-web
# COOKIE_SECURE is intentionally left unset: access_token cookies are marked
# 'secure' automatically when NODE_ENV=production. Set it to true/false only to
# override that behaviour (e.g. 'true' when terminating TLS behind a proxy,
# 'false' never for production).
COOKIE_SAME_SITE=lax
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Optional: path to an extra CA certificate (PEM) trusted IN ADDITION to Node's
# built-in trust store, for mail servers that present a private/corporate root
# (e.g. an antivirus SMTP scanner). Leave unset in normal deployments. Never
# disable SMTP_TLS_REJECT_UNAUTHORIZED to work around this - use this instead.
# SMTP_CA_CERT=data/custom-mail-root.pem
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM="Hanson HR <your-email@gmail.com>"
# Preferred in production: send over an HTTPS email API instead of SMTP. This is
# required on hosts that block outbound SMTP ports (25/465/587), such as Render's
# free web services. Set EMAIL_API_KEY to switch to HTTP; leave it unset for SMTP.
# EMAIL_PROVIDER=resend        # resend | brevo | sendgrid (defaults to resend)
# EMAIL_API_KEY=your-provider-api-key
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
SEED_PASSWORD=replace-with-a-unique-seed-password
