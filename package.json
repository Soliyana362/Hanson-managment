{
  "name": "glorious-hr-management",
  "version": "1.0.0",
  "private": true,
  "description": "Glorious HR Management System",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "db:create": "npm run db:create --prefix backend",
    "db:setup": "npm run db:setup --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:all": "npm run dev",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "setup": "npm run install:all && npm run db:create && npm run db:setup && npm run db:seed"
  },
  "dependencies": {
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
